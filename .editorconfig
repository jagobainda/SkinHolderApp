# EditorConfig — https://editorconfig.org
#
# This file configures the IDE. It does NOT configure the formatting gate:
# Spotless' ktlint step does not read it (see `ktlintSettings` in
# build.gradle.kts, which is where the gate's copy of these values lives). The
# ktlint_* keys below are duplicated there on purpose so the IDE and the gate
# format alike — change one, change the other.
root = true

[*]
charset                  = utf-8
end_of_line              = crlf
indent_style             = space
indent_size              = 4
trim_trailing_whitespace = true
insert_final_newline     = true

[*.md]
trim_trailing_whitespace = false

[*.{kt,kts}]
max_line_length = 120
ktlint_code_style = intellij_idea
ktlint_standard_backing-property-naming = disabled

# Import order is alphabetical with no groupings and no wildcards.
ij_kotlin_imports_layout = *
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# Shell scripts are LF or they do not run on the Linux CI runner. `gradlew` is
# generated by Gradle and must never be "fixed" to CRLF; see .gitattributes,
# which enforces the same thing at the Git level.
[{gradlew,*.sh}]
end_of_line = lf

[*.{yml,yaml}]
indent_size = 2

[*.toml]
indent_size = 4
